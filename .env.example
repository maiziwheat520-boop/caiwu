LEDGERBRIDGE_ENV=development
LEDGERBRIDGE_LOG_LEVEL=INFO
LEDGERBRIDGE_DATABASE_URL=postgresql+psycopg://ledgerbridge_app:change-me-runtime@postgres:5432/ledgerbridge
LEDGERBRIDGE_MIGRATION_DATABASE_URL=postgresql+psycopg://ledgerbridge_owner:change-me-owner@postgres:5432/ledgerbridge
LEDGERBRIDGE_APP_DB_PASSWORD=change-me-runtime
LEDGERBRIDGE_ARTIFACT_ROOT=/var/lib/ledgerbridge/artifacts
LEDGERBRIDGE_ARTIFACT_MAX_BYTES=52428800
LEDGERBRIDGE_REVISION=dev
DEPLOYED_REVISION=dev

# Copy this file to .env and replace locally. Never commit real values.
POSTGRES_DB=ledgerbridge
POSTGRES_USER=ledgerbridge_owner
POSTGRES_PASSWORD=change-me-owner
