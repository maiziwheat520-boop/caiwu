LEDGERBRIDGE_ENV=development
LEDGERBRIDGE_LOG_LEVEL=INFO
LEDGERBRIDGE_ENABLE_INTERNAL_UPLOAD=false
LEDGERBRIDGE_ENABLE_INTERNAL_READ_API=false
LEDGERBRIDGE_ENABLE_REVIEW_API=false
LEDGERBRIDGE_ENABLE_REAL_INGEST=false
# Disposable test-period gate. 2026-09 and later always remain under manual review.
LEDGERBRIDGE_TEST_HISTORICAL_AUTO_IMPORT_ENABLED=false
LEDGERBRIDGE_TEST_HISTORICAL_AUTO_IMPORT_CUTOFF_MONTH=2026-08
# Compatibility URL for local tooling/tests; production services use the role-specific URLs below.
LEDGERBRIDGE_DATABASE_URL=postgresql+psycopg://ledgerbridge_app:change-me-runtime@postgres:5432/ledgerbridge
LEDGERBRIDGE_API_DATABASE_URL=postgresql+psycopg://ledgerbridge_api:change-me-api@postgres:5432/ledgerbridge
LEDGERBRIDGE_WORKER_DATABASE_URL=postgresql+psycopg://ledgerbridge_worker:change-me-worker@postgres:5432/ledgerbridge
LEDGERBRIDGE_READER_DATABASE_URL=postgresql+psycopg://ledgerbridge_reader:change-me-reader@postgres:5432/ledgerbridge
LEDGERBRIDGE_MIGRATION_DATABASE_URL=postgresql+psycopg://ledgerbridge_owner:change-me-owner@postgres:5432/ledgerbridge
LEDGERBRIDGE_ORIGINAL_RECONCILIATION_LAYOUT_HOST_FILE=/absolute/private/original-reconciliation-layout.json
LEDGERBRIDGE_ORIGINAL_RECONCILIATION_LAYOUT_SHA256=replace-with-reviewed-layout-sha256
LEDGERBRIDGE_APP_DB_PASSWORD=change-me-runtime
LEDGERBRIDGE_API_DB_PASSWORD=change-me-api
LEDGERBRIDGE_WORKER_DB_PASSWORD=change-me-worker
LEDGERBRIDGE_READER_DB_PASSWORD=change-me-reader
LEDGERBRIDGE_ARTIFACT_ROOT=/var/lib/ledgerbridge/artifacts
LEDGERBRIDGE_ARTIFACT_MAX_BYTES=52428800
LEDGERBRIDGE_ARTIFACT_TOTAL_MAX_BYTES=10737418240
LEDGERBRIDGE_ARTIFACT_STAGING_MAX_BYTES=536870912
LEDGERBRIDGE_ARTIFACT_STAGING_TTL_SECONDS=3600
LEDGERBRIDGE_REVISION=dev
DEPLOYED_REVISION=dev

# Payroll live integration is enabled only with docker-compose.payroll-live.yml.
# Values below are deployment references/placeholders; never commit real HMAC secrets.
LEDGERBRIDGE_PAYROLL_BASE_URL=http://payroll-verification:4318
LEDGERBRIDGE_PAYROLL_TIMEOUT_SECONDS=5
LEDGERBRIDGE_PAYROLL_COMPANY_MAPPING={"00000000-0000-4000-8000-000000000001":"00000000-0000-4000-8000-000000000002"}
LEDGERBRIDGE_PAYROLL_BFF_USER_ASSERTION_KEY=replace-with-32-byte-or-longer-secret
LEDGERBRIDGE_PAYROLL_BFF_USER_ASSERTION_ISSUER=LedgerBridge-Web
LEDGERBRIDGE_PAYROLL_BFF_USER_ASSERTION_AUDIENCE=LedgerBridge-Core
LEDGERBRIDGE_PAYROLL_PROVIDER_WORKLOAD_ASSERTION_KEY=replace-with-independent-32-byte-secret
LEDGERBRIDGE_PAYROLL_PROVIDER_USER_ASSERTION_KEY=replace-with-another-independent-secret
LEDGERBRIDGE_PAYROLL_PROVIDER_SERVICE_SUBJECT=workload:ledgerbridge-core
LEDGERBRIDGE_ENABLE_PAYROLL_COMMANDS=false
LEDGERBRIDGE_PAYROLL_PROVIDER_TRUSTED_COMMAND_CONTRACT=disabled
LEDGERBRIDGE_PAYROLL_COMMAND_ALLOWLIST=[]
LEDGERBRIDGE_PAYROLL_ROLE_BINDINGS={}

# Copy this file to .env and replace locally. Never commit real values.
POSTGRES_DB=ledgerbridge
POSTGRES_USER=ledgerbridge_owner
POSTGRES_PASSWORD=change-me-owner
