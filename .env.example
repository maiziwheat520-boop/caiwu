LEDGERBRIDGE_ENV=development
LEDGERBRIDGE_LOG_LEVEL=INFO
LEDGERBRIDGE_ENABLE_INTERNAL_UPLOAD=false
LEDGERBRIDGE_ENABLE_REVIEW_API=false
LEDGERBRIDGE_ENABLE_REAL_INGEST=false
# Compatibility URL for local tooling/tests; production services use the role-specific URLs below.
LEDGERBRIDGE_DATABASE_URL=postgresql+psycopg://ledgerbridge_app:change-me-runtime@postgres:5432/ledgerbridge
LEDGERBRIDGE_API_DATABASE_URL=postgresql+psycopg://ledgerbridge_api:change-me-api@postgres:5432/ledgerbridge
LEDGERBRIDGE_WORKER_DATABASE_URL=postgresql+psycopg://ledgerbridge_worker:change-me-worker@postgres:5432/ledgerbridge
LEDGERBRIDGE_MIGRATION_DATABASE_URL=postgresql+psycopg://ledgerbridge_owner:change-me-owner@postgres:5432/ledgerbridge
LEDGERBRIDGE_APP_DB_PASSWORD=change-me-runtime
LEDGERBRIDGE_API_DB_PASSWORD=change-me-api
LEDGERBRIDGE_WORKER_DB_PASSWORD=change-me-worker
LEDGERBRIDGE_ARTIFACT_ROOT=/var/lib/ledgerbridge/artifacts
LEDGERBRIDGE_ARTIFACT_MAX_BYTES=52428800
LEDGERBRIDGE_ARTIFACT_TOTAL_MAX_BYTES=10737418240
LEDGERBRIDGE_ARTIFACT_STAGING_MAX_BYTES=536870912
LEDGERBRIDGE_ARTIFACT_STAGING_TTL_SECONDS=3600
LEDGERBRIDGE_REVISION=dev
DEPLOYED_REVISION=dev

# Copy this file to .env and replace locally. Never commit real values.
POSTGRES_DB=ledgerbridge
POSTGRES_USER=ledgerbridge_owner
POSTGRES_PASSWORD=change-me-owner
