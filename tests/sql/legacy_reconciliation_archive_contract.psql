\set ON_ERROR_STOP on
BEGIN;

SET ROLE ledgerbridge_worker;
INSERT INTO reconciliation_legacy.source (
    source_ref, entity_ref, scope_pairs, source_sha256, source_bytes,
    original_filename, sheet_count, imported_by
) VALUES (
    '99999999-9999-4999-8999-999999999999',
    '11111111-1111-4111-8111-111111111111',
    '[{"entity_ref":"11111111-1111-4111-8111-111111111111", "business_unit_ref":"hotel"},
      {"entity_ref":"22222222-2222-4222-8222-222222222222", "business_unit_ref":"hotel"}]'::jsonb,
    decode(repeat('ab', 32), 'hex'), decode('deadbeef', 'hex'),
    'synthetic.xlsx', 1, 'test'
);
INSERT INTO reconciliation_legacy.sheet (
    source_ref, period, sheet_name, row_count, cell_count, content_sha256, cells
) VALUES (
    '99999999-9999-4999-8999-999999999999', '2024-01', '24.01', 1, 1,
    decode(repeat('cd', 32), 'hex'),
    '[{"address":"A1","type":"text","value":"synthetic","cached_type":null,"cached_value":null}]'::jsonb
);

SET ROLE ledgerbridge_api;
DO $$
BEGIN
    IF (SELECT count(*) FROM reconciliation_legacy.month_read
        WHERE period = '2024-01') <> 1 THEN
        RAISE EXCEPTION 'API historical view is unavailable';
    END IF;
    BEGIN
        EXECUTE 'SELECT source_bytes FROM reconciliation_legacy.source LIMIT 1';
        RAISE EXCEPTION 'API can read raw workbook bytes';
    EXCEPTION WHEN insufficient_privilege THEN NULL;
    END;
END;
$$;

RESET ROLE;
DO $$
BEGIN
    BEGIN
        UPDATE reconciliation_legacy.sheet SET row_count = 2
         WHERE period = '2024-01';
        RAISE EXCEPTION 'historical sheet mutated';
    EXCEPTION WHEN raise_exception THEN
        IF SQLERRM = 'historical sheet mutated' THEN RAISE; END IF;
    END;
END;
$$;

ROLLBACK;
